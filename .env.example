# ═══════════════════════════════════════════════════════════════════════════════
# SPECTRAL INDEX AGENT — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` and fill in your credentials.
#
#   cp .env.example .env        # Linux / macOS
#   copy .env.example .env      # Windows
#
# All variables use the SPECTRAL_ prefix so they don't collide with other apps.
# ═══════════════════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────────────
SPECTRAL_ENVIRONMENT=development
SPECTRAL_LOG_LEVEL=INFO
SPECTRAL_DEBUG=false

# ── Data Paths (optional — sensible defaults used) ───────────────────────────
# SPECTRAL_DATA_DIR=data
# SPECTRAL_RAW_DATA_DIR=data/raw
# SPECTRAL_PROCESSED_DATA_DIR=data/processed
# SPECTRAL_CACHE_DIR=data/cache

# ── USGS EarthExplorer / M2M API (Landsat) ──────────────────────────────────
# Register at https://ers.cr.usgs.gov/register
SPECTRAL_USGS_USERNAME=
SPECTRAL_USGS_TOKEN=

# ── Copernicus Data Space (Sentinel-2) ───────────────────────────────────────
# Register at https://dataspace.copernicus.eu/
SPECTRAL_COPERNICUS_CLIENT_ID=
SPECTRAL_COPERNICUS_CLIENT_SECRET=

# ── LLM Providers ───────────────────────────────────────────────────────────
# At least one is required for the agent to work.
SPECTRAL_OPENAI_API_KEY=
SPECTRAL_ANTHROPIC_API_KEY=

# ── LLM Defaults ────────────────────────────────────────────────────────────
SPECTRAL_DEFAULT_LLM_PROVIDER=openai
SPECTRAL_DEFAULT_LLM_MODEL=gpt-4o
SPECTRAL_LLM_TEMPERATURE=0.0
SPECTRAL_LLM_MAX_TOKENS=4096

# ── Observability (optional) ────────────────────────────────────────────────
# SPECTRAL_LANGSMITH_API_KEY=
# SPECTRAL_LANGSMITH_PROJECT=spectral-agent
# SPECTRAL_ENABLE_TRACING=false

# ── HTTP / Networking ───────────────────────────────────────────────────────
# SPECTRAL_REQUEST_TIMEOUT=300
# SPECTRAL_MAX_RETRIES=3
